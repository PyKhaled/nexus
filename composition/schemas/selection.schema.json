{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/selection.schema.json",
  "title": "Nexus product composition selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "product", "deployment"],
  "properties": {
    "apiVersion": {"const": "nexus.io/composition/v1alpha1"},
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "edition"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
        "edition": {"enum": ["community", "enterprise", "custom"]},
        "description": {"type": "string"}
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "environment", "assurance"],
      "properties": {
        "target": {"enum": ["local", "self-hosted"]},
        "environment": {"enum": ["development", "production"]},
        "assurance": {"enum": ["standard", "hardened", "high-assurance"]}
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$"},
        "policy": {"enum": ["public-allowed", "private-preferred", "private-only"]}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {"type": "string"},
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["implementation"],
            "properties": {
              "implementation": {"type": "string"},
              "enabled": {"type": "boolean"}
            }
          }
        ]
      }
    }
  }
}
