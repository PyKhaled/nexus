# Copy to .env and set strong, unique values before starting the stack.
# Consumed directly by the Keycloak image via env_file — do not rename these
# keys. Anything marked <required> has no safe default.

# --- Database ------------------------------------------------------------
# Keycloak has its own Postgres instance (system-auth-keycloak-db), separate
# from system-auth-db (Authentik). Do not point this at the Authentik DB.
KC_DB=postgres
KC_DB_URL_HOST=keycloak-db
KC_DB_URL_PORT=5432
KC_DB_URL_DATABASE=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=<required>
KC_DB_POOL_MIN_SIZE=10
KC_DB_POOL_MAX_SIZE=50

# --- Hostname / proxy ------------------------------------------------------
# nginx (system-loadbalancer) terminates TLS and forwards plain HTTP, so
# Keycloak trusts X-Forwarded-* rather than terminating TLS itself.
KC_HOSTNAME=<required, e.g. sso.yourdomain.tld>
KC_HOSTNAME_STRICT=true
KC_PROXY_HEADERS=xforwarded
KC_HTTP_ENABLED=true

# --- Bootstrap admin ---------------------------------------------------
# Used only to create the initial admin account on first boot. Rotate or
# disable this account after logging in and creating a named admin user.
KC_BOOTSTRAP_ADMIN_USERNAME=<required>
KC_BOOTSTRAP_ADMIN_PASSWORD=<required>

# --- Clustering ------------------------------------------------------------
# Only needed once you run more than one Keycloak replica; local cache
# (the default) does not share sessions across containers.
# KC_CACHE=ispn
# KC_CACHE_STACK=<jdbc-ping|kubernetes|...>
