# Development placeholders only. Copy to .env and replace every change-me
# value with a strong, unique secret before any shared deployment.
# Consumed directly by the Keycloak image via env_file; do not rename the keys.

# --- Database ------------------------------------------------------------
# Keycloak has its own Postgres instance. Do not point this at another
# application's database.
KC_DB=postgres
KC_DB_URL_HOST=keycloak-db
KC_DB_URL_PORT=5432
KC_DB_URL_DATABASE=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=change-me-keycloak-db-password
KC_DB_POOL_MIN_SIZE=10
KC_DB_POOL_MAX_SIZE=50

# --- Hostname / proxy ------------------------------------------------------
# NGINX (system-gateway) terminates TLS and forwards plain HTTP, so
# Keycloak trusts X-Forwarded-* rather than terminating TLS itself.
KC_HOSTNAME=auth.localhost
KC_HOSTNAME_STRICT=false
KC_PROXY_HEADERS=xforwarded
KC_HTTP_ENABLED=true

# --- Bootstrap admin ---------------------------------------------------
# Used only to create the initial admin account on first boot. Rotate or
# disable this account after logging in and creating a named admin user.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-keycloak-admin-password

# --- Clustering ------------------------------------------------------------
# Only needed once you run more than one Keycloak replica; local cache
# (the default) does not share sessions across containers.
# KC_CACHE=ispn
# KC_CACHE_STACK=<jdbc-ping|kubernetes|...>
