# Rendered as an include file; it is not loaded as a top-level server config.
location /oauth2/ {
    proxy_pass http://$gateway_auth_request_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Auth-Request-Redirect $scheme://$host$request_uri;
}

location = /_oauth2_auth {
    internal;
    proxy_pass http://$gateway_auth_request_upstream/oauth2/auth;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Uri $request_uri;
}

location @oauth2_signin {
    return 302 /oauth2/start?rd=$scheme://$host$request_uri;
}

location / {
    auth_request /_oauth2_auth;
    error_page 401 = @oauth2_signin;

    auth_request_set $auth_user $upstream_http_x_auth_request_user;
    auth_request_set $auth_email $upstream_http_x_auth_request_email;
    auth_request_set $auth_groups $upstream_http_x_auth_request_groups;
    auth_request_set $auth_token $upstream_http_x_auth_request_access_token;
    auth_request_set $auth_header $upstream_http_authorization;
    auth_request_set $auth_cookie $upstream_http_set_cookie;

    proxy_set_header X-User $auth_user;
    proxy_set_header X-Email $auth_email;
    proxy_set_header X-Groups $auth_groups;
    proxy_set_header X-Access-Token $auth_token;
    proxy_set_header Authorization $auth_header;
    add_header Set-Cookie $auth_cookie always;

    set $gateway_api_upstream "${API_UPSTREAM}";

    limit_req zone=api_per_ip burst=${API_RATE_BURST} nodelay;
    limit_req_status 429;

    include /etc/nginx/snippets/proxy-headers.conf;
    include /etc/nginx/snippets/proxy-timeouts.conf;
    include /etc/nginx/snippets/security-headers.conf;

    proxy_pass http://$gateway_api_upstream;
}
