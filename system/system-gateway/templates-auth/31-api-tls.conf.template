server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${API_DOMAIN};

    ssl_certificate ${TLS_CERTIFICATE};
    ssl_certificate_key ${TLS_CERTIFICATE_KEY};
    include /etc/nginx/snippets/tls.conf;

    set $gateway_auth_request_upstream "${AUTH_REQUEST_UPSTREAM}";
    include /etc/nginx/conf.d/oauth2-api.inc;
}
