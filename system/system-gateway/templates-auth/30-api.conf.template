limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=${API_RATE_LIMIT};

server {
    listen 80;
    listen [::]:80;
    server_name ${API_DOMAIN};

    if ($gateway_tls_redirect = 1) {
        return 301 https://$host$request_uri;
    }

    set $gateway_auth_request_upstream "${AUTH_REQUEST_UPSTREAM}";
    include /etc/nginx/conf.d/oauth2-api.inc;
}
