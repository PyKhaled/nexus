# Domains exposed by the gateway.
APP_DOMAIN=app.localhost
AUTH_DOMAIN=auth.localhost
STATUS_DOMAIN=status.localhost
OVERSEER_DOMAIN=overseer.localhost
API_DOMAIN=api.localhost

# Docker DNS names and internal ports. Do not use host-published ports here.
APP_UPSTREAM=website:80
AUTH_UPSTREAM=keycloak:8080
STATUS_UPSTREAM=status:3000
OVERSEER_UPSTREAM=overseer:8765
API_UPSTREAM=api:8000

# API policy defaults.
API_RATE_LIMIT=20r/s
API_RATE_BURST=40

# Published host ports.
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443

# Optional TLS documentation overlay.
GATEWAY_TLS_DIR=./system/system-gateway/ssl
TLS_CERTIFICATE=/etc/nginx/ssl/fullchain.pem
TLS_CERTIFICATE_KEY=/etc/nginx/ssl/privkey.pem

# Optional API-authentication documentation overlay.
AUTH_REQUEST_UPSTREAM=oauth2-proxy:4180
OIDC_CLIENT_ID=nexus-api
OIDC_CLIENT_SECRET=change-me-oidc-client-secret
OIDC_COOKIE_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
OIDC_ISSUER_URL=http://auth.localhost/realms/nexus
OIDC_REDIRECT_URL=http://api.localhost/oauth2/callback
OIDC_EMAIL_DOMAINS=*
OIDC_COOKIE_SECURE=false
