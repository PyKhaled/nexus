# Nexus Compose credentials. Keep the real file private (600 or 640), outside Git.
# Uncomment and fill only the values you need; never put credentials in config.env.
# The development Compose file falls back to development placeholders.
# Production secrets must be supplied according to the selected deployment package.

# WordPress / MySQL; omit these when using the mounted-secrets overlay.
# MYSQL_PASSWORD=
# MYSQL_ROOT_PASSWORD=

# Keycloak / PostgreSQL: these two values must match.
# KC_DB_PASSWORD=
# POSTGRES_PASSWORD=
# KC_BOOTSTRAP_ADMIN_PASSWORD=

# Kener
# KENER_SECRET_KEY=
