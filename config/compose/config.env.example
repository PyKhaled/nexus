# Nexus Compose configuration. Literal single-line KEY=value entries.
# make config-init copies this to the runtime directory without overwriting.
# Values below are development examples; production requires deployment-specific values.
# Uncomment only the overrides you need. Compose supplies development defaults.

# Gateway
# APP_DOMAIN=localhost
# AUTH_DOMAIN=auth.localhost
# STATUS_DOMAIN=status.localhost
# OVERSEER_DOMAIN=overseer.localhost
# API_DOMAIN=api.localhost
# GATEWAY_HTTP_PORT=80

# WordPress database (shared by website and website-db)
# MYSQL_DATABASE=wordpress
# MYSQL_USER=wordpress

# Keycloak and its database: keep the database name/user consistent on both sides.
# KC_DB_URL_DATABASE=keycloak
# KC_DB_USERNAME=keycloak
# POSTGRES_DB=keycloak
# POSTGRES_USER=keycloak
# KC_HOSTNAME=auth.localhost
# KC_BOOTSTRAP_ADMIN_USERNAME=admin

# Optional mounted WordPress/MySQL secrets (absolute paths on the Docker host).
# MYSQL_PASSWORD_FILE=/etc/nexus/secrets/mysql_password
# MYSQL_ROOT_PASSWORD_FILE=/etc/nexus/secrets/mysql_root_password
